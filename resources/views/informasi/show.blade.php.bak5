                                <span class="info-desc">{{ $item->keterangan }}</span>
                            @endif
                        </span>
                    @endif
                    @if ($item->file_url)
                        @if ($item->file_info)
                        <span class="info-meta">{{ $item->file_info }}</span>
                    @endif
                    <a href="{{ $item->file_url }}" class="info-download" target="_blank" aria-label="Unduh {{ $item->judul }}">Unduh</a>
