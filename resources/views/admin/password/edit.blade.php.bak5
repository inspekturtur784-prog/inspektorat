            <input type="checkbox" id="toggleAkunPassword" style="width: auto; cursor: pointer;">
            Tampilkan Kata Sandi
        </label>
    </div>

    <button type="submit" class="btn-admin btn-admin-primary">Simpan Perubahan</button>
</form>

<script>
    document.getElementById('toggleAkunPassword').addEventListener('change', function () {
        var tipe = this.checked ? 'text' : 'password';
        ['password', 'password_confirmation', 'akun_current_password'].forEach(function (id) {
            document.getElementById(id).type = tipe;
        });
    });
</script>

