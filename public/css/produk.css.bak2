html { scroll-behavior: smooth; }

.produk { padding: 88px 0; background: #fff; }
.produk > .container { max-width: 1180px; margin: 0 auto; padding: 0 24px; box-sizing: border-box; }

.produk .eyebrow { display: inline-flex; align-items: center; gap: 12px; color: #c9a227; font-weight: 700; letter-spacing: .12em; font-size: .85rem; }
.produk .eyebrow::before { content: ""; width: 28px; height: 2px; background: #c9a227; }
.produk h2 { color: #0b2545; margin: 12px 0 8px; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1.25; }
.produk .sub { color: #5b6b7f; max-width: 560px; margin: 0 0 44px; line-height: 1.7; }

.produk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; }

.produk-card { display: flex; flex-direction: column; padding: 32px 28px; background: #fff; border: 1px solid #e3e8ef; border-radius: 16px; text-decoration: none; color: inherit; transition: transform .25s, box-shadow .25s, border-color .25s; }
.produk-card:hover { transform: translateY(-6px); box-shadow: 0 18px 36px rgba(11,37,69,.12); border-color: #c9a227; }

.produk-icon { width: 56px; height: 56px; display: grid; place-items: center; border-radius: 14px; background: #0b2545; color: #f5c518; font-size: 1.6rem; margin-bottom: 22px; transition: background .25s, color .25s; }
.produk-card:hover .produk-icon { background: #c9a227; color: #0b2545; }

.produk-card h3 { color: #0b2545; font-size: 1.25rem; margin: 0 0 10px; }
.produk-card p { color: #5b6b7f; font-size: .95rem; line-height: 1.65; margin: 0; }

.produk-link { display: inline-block; margin-top: auto; padding-top: 22px; color: #c9a227; font-weight: 600; transition: transform .25s; }
.produk-card:hover .produk-link { transform: translateX(6px); }

@media (max-width: 640px) {
  .produk { padding: 56px 0; }
  .produk .sub { margin-bottom: 28px; }
  .produk-card { padding: 26px 22px; }
}